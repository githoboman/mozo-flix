# ============================================================
# Stacks (client-safe — these are exposed in the browser)
# ============================================================
NEXT_PUBLIC_STACKS_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=ST9NSDHK5969YF6WJ2MRCVVAVTDENWBNTFJRVZ3E

# ============================================================
# Server-only secrets (NO NEXT_PUBLIC_ prefix — never sent to browser)
# ============================================================

# Pinata IPFS — used by /api/ipfs-upload to pin video files.
# Get a JWT at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# Optional: custom Pinata gateway (e.g. mygateway.mypinata.cloud)
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# AgentRouter (or any OpenAI-compatible LLM gateway) for AI Upload Assistant.
# Sign up at agentrouter.org, paste your sk- key here.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=claude-haiku-4-5-20251001
# Optional secondary token if the gateway requires one
AGENTROUTER_USER_TOKEN=

# Backend signing key for /api/distribute-reward (calls mozoflix-rewards
# on behalf of the platform, after server-side completion verification).
# Generate one with: npx @stacks/cli make_keychain -t
# Use the keyInfo.privateKey field. For testnet you can reuse the deployer
# key. For mainnet, USE A SEPARATE KEY.
BACKEND_PRIVATE_KEY=
STACKS_NETWORK=testnet

# ============================================================
# Firebase (client-safe — used by lib/firebase.ts)
# Leave blank to disable Firestore reads/writes (the app will fall
# back to localStorage for off-chain data).
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
